
// Prisma Client generator for the JavaScript backend.
generator client {
  provider = "prisma-client-js"
}

// PostgreSQL database configuration.
datasource db {
  provider = "postgresql"
}

// Available roles for project members.
enum ProjectRole {
  OWNER
  MEMBER
}

// Available task statuses.
enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

// Available task priorities.
enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

// Stores registered users.
model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Projects owned by this user.
  projects Project[]

  // Projects this user participates in.
  memberships ProjectMember[]

  // Tasks created by this user.
  createdTasks Task[] @relation("TaskCreator")

  // Tasks assigned to this user.
  assignedTasks Task[] @relation("TaskAssignee")
}

// Stores projects and their owners.
model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // User who owns this project.
  owner User @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  // Users participating in this project.
  members ProjectMember[]

  // Tasks created within this project.
  tasks Task[]
}

// Junction table connecting users and projects.
model ProjectMember {
  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)

  // Associated user and project.
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // A user can join a project only once.
  @@id([userId, projectId])
}

// Stores tasks belonging to projects.
model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  projectId   String
  creatorId   String
  assigneeId  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Project to which this task belongs.
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // User who created this task.
  creator User @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: Restrict)

  // User assigned to this task, if any.
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
}
